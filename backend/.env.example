# --- Backend Environment Configuration ---

# Application Environment: 'development' hoặc 'production'
# Khi ở 'production', giao diện vô hiệu hóa nút chuyển tài khoản demo tự do
APP_ENV=development

# Host & Port của FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Security: Chuỗi khóa bí mật ký JWT (BẮT BUỘC đổi trong môi trường thật)
# Tạo chuỗi ngẫu nhiên bằng lệnh: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-this-in-production-c9a1b2d3e4f5
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Adapter Mode: 'mock' (phát triển không có ROS) hoặc 'ros' (dùng rclpy trong ROS 2 Jazzy)
ROBOT_ADAPTER_MODE=mock

# Cấu hình ROS 2 (khi ROBOT_ADAPTER_MODE=ros)
ROS_DOMAIN_ID=0
ROS_NODE_NAME=airport_guide_backend_node
ROS_MAP_FRAME=map
ROS_BASE_FRAME=base_link
ROS_ODOM_FRAME=odom

# CORS Allowed Origins (phân tách bởi dấu phẩy, dùng * cho dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
